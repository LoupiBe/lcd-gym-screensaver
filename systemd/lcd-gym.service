[Unit]
Description=LCD Gym Screensaver (Anti-marquage & Dépolarisation)
After=network.target

[Service]
Type=simple
User=kiosk
Group=kiosk

PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

RuntimeDirectory=kiosk
Environment=XDG_RUNTIME_DIR=/run/kiosk
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=QT_QPA_PLATFORM=wayland
Environment=GDK_BACKEND=wayland

# Lancement du screensaver en mode autonome avec extinction auto après 10 min (600s)
ExecStart=/home/kiosk/lcd-gym-screensaver/launch-kiosk.sh

# Extinction physique du signal HDMI dès la fin du processus
ExecStopPost=/bin/sh -c 'for p in /sys/class/drm/card*-HDMI-A-*/status; do [ -f "$p" ] && echo "off" > "$p"; done'

Restart=no

[Install]
WantedBy=graphical.target
